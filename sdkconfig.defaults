# Shared ESP-IDF settings for all targets (ESP32, ESP32-S3)
# Target-specific overrides in sdkconfig.defaults.esp32 / sdkconfig.defaults.esp32s3

# --- Power Management (key enabler for light sleep with WiFi) ---
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_ESP_WIFI_SLP_IRAM_OPT=y
CONFIG_ESP_WIFI_SLP_DEFAULT_MIN_ACTIVE_TIME=50
CONFIG_ESP_WIFI_SLP_DEFAULT_MAX_ACTIVE_TIME=60
# When a beacon is missed (interference, router busy), the default behavior
# wakes to full power and aggressively scans. This optimization uses gentler
# recovery with fewer wakes and less TX power during beacon loss events.
CONFIG_ESP_WIFI_SLP_BEACON_LOST_OPT=y

# --- WiFi ---
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y

# --- lwIP (IPv6 disabled — saves ~0.2-0.5mA) ---
# IPv6 adds MLD6 multicast reports every 40s + neighbor discovery traffic,
# each waking the WiFi radio. Our server connects over IPv4 only.
CONFIG_LWIP_IPV6=n

# --- lwIP (light sleep optimization) ---
# Default is 1 second, which wakes the CPU from light sleep every second
# to check DHCP lease renewal. DHCP leases are typically hours long.
# Kconfig range caps this at 10s (range 1-10). Set to max allowed.
CONFIG_LWIP_DHCP_COARSE_TIMER_SECS=10
# TCP timer fires unconditionally every TCP_TMR_INTERVAL ms to process
# delayed ACKs (tcp_fasttmr) and retransmission timeouts (tcp_slowtmr).
# CONFIG_LWIP_TIMERS_ONDEMAND does NOT cover this timer — it always wakes
# the CPU from light sleep. Default 250ms = 4 wakes/sec on an idle connection.
# 1000ms reduces wakes by 75%. Safe for our receive-heavy WebSocket use case:
# delayed ACKs up to 1s (within TCP spec), retransmit granularity 2s (vs 500ms).
CONFIG_LWIP_TCP_TMR_INTERVAL=1000

# --- mbedTLS (ECDH + AES-GCM encryption) ---
CONFIG_MBEDTLS_ECDH_C=y
CONFIG_MBEDTLS_GCM_C=y
CONFIG_MBEDTLS_HKDF_C=y
CONFIG_MBEDTLS_ECP_DP_SECP256R1_ENABLED=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# --- LittleFS (config.json storage) ---
CONFIG_LITTLEFS_MAX_PARTITIONS=1

# --- Flash (LilyGo T5 has 4MB flash) ---
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# --- Partition table ---
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- OTA ---
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# --- FreeRTOS ---
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=4096

# --- HTTP client (for OTA, pairing, timezone) ---
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y

# --- Logging ---
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

# --- Stack sizes ---
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# --- Watchdog ---
# The task watchdog watches the idle tasks: if any task keeps a CPU busy for
# 30s without yielding, panic and reset instead of hanging silently. A reset
# during an update's probation boots the previous firmware, and after
# confirmation it feeds the OTA crash-loop guard (see ota_manager.cpp).
# All e-paper busy-waits yield (vTaskDelay), so long refreshes don't trip it.
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
CONFIG_ESP_TASK_WDT_PANIC=y
