# Build output
build/
managed_components/

# sdkconfig is generated by menuconfig — only defaults are tracked
sdkconfig
sdkconfig.old

# Dependencies lock (regenerated by idf.py)
dependencies.lock

# Device-specific config (contains auth tokens, server URL, device ID)
data/config.json

# LittleFS filesystem image (generated by flash.sh)
data/*.bin

# ESP-IDF environment activation scripts (machine-specific paths)
esp_idf_activate_*/

# Temp files from idf.py builds
tmp*idf_*

# Build cache
.cache/

# IDE
.vscode/
.idea/

# macOS
.DS_Store
